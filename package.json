{
  "name": "dash-stack",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend run dev",
    "dev:backend": "pnpm --filter backend run dev",
    "build:frontend": "pnpm --filter frontend run build",
    "build:backend": "pnpm --filter backend run build",
    "lint:frontend": "pnpm --filter frontend run lint",
    "lint:backend": "pnpm --filter backend run lint",
    "lint": "pnpm run lint:frontend && pnpm run lint:backend",
    "format:frontend": "pnpm --filter frontend run format",
    "format:backend": "pnpm --filter backend run format",
    "prepare": "husky",
    "docker:up": "docker compose --env-file backend/.env --env-file frontend/.env up -d",
    "docker:up:build": "docker compose --env-file backend/.env --env-file frontend/.env up -d --build",
    "docker:down": "docker compose --env-file backend/.env --env-file frontend/.env down",
    "docker:dev": "docker compose --env-file backend/.env --env-file frontend/.env -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose --env-file backend/.env --env-file frontend/.env -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose --env-file backend/.env --env-file frontend/.env -f docker-compose.dev.yml down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "sonar:up": "docker compose --env-file .env.sonarqube -f docker-compose.sonarqube.yml up -d sonarqube",
    "sonar:down": "docker compose --env-file .env.sonarqube -f docker-compose.sonarqube.yml down",
    "sonar:logs": "docker compose --env-file .env.sonarqube -f docker-compose.sonarqube.yml logs -f sonarqube",
    "sonar:status": "docker compose --env-file .env.sonarqube -f docker-compose.sonarqube.yml ps",
    "sonar:scan": "docker compose --env-file .env.sonarqube -f docker-compose.sonarqube.yml --profile scan run --rm sonar-scanner",
    "knip": "knip"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^16.2.7"
  },
  "pnpm": {
    "overrides": {
      "ajv@^8.0.0": "8.20.0",
      "cross-spawn": "6.0.6",
      "deepmerge-ts": "8.0.0",
      "fast-uri": "3.1.6",
      "file-type": "21.3.2",
      "js-yaml@^3.0.0": "3.15.2",
      "js-yaml@^4.0.0": "4.3.2",
      "js-yaml@^5.0.0": "5.2.2",
      "multer": "2.4.0",
      "mysql2": "3.23.1",
      "postcss": "8.5.26",
      "qs": "6.16.0",
      "tar": "7.5.21"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "bcrypt",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}

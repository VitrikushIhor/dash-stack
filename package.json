{
  "name": "dash-stack",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend run dev",
    "dev:backend": "pnpm --filter backend run dev",
    "build:frontend": "pnpm --filter frontend run build",
    "build:backend": "pnpm --filter backend run build",
    "lint:frontend": "pnpm --filter frontend run lint",
    "lint:backend": "pnpm --filter backend run lint",
    "lint": "pnpm run lint:frontend && pnpm run lint:backend",
    "format:frontend": "pnpm --filter frontend run format",
    "format:backend": "pnpm --filter backend run format",
    "prepare": "husky",
    "docker:up": "docker compose --env-file backend/.env --env-file frontend/.env up -d",
    "docker:up:build": "docker compose --env-file backend/.env --env-file frontend/.env up -d --build",
    "docker:down": "docker compose --env-file backend/.env --env-file frontend/.env down",
    "docker:dev": "docker compose --env-file backend/.env --env-file frontend/.env -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose --env-file backend/.env --env-file frontend/.env -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose --env-file backend/.env --env-file frontend/.env -f docker-compose.dev.yml down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "knip": "knip"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^16.2.7"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "pnpm --filter frontend run lint:fix",
      "pnpm --filter frontend run format",
      "pnpm --filter frontend run test:related"
    ],
    "backend/**/*.ts": [
      "pnpm --filter backend run lint",
      "pnpm --filter backend run format"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "bcrypt",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}

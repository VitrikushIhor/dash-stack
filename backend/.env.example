# ============================================
# DATABASE
# ============================================
POSTGRES_USER=prisma
POSTGRES_PASSWORD=topsecret
POSTGRES_DB=blog
DB_SCHEMA=blog
DATABASE_URL=postgresql://prisma:topsecret@localhost:5432/blog?schema=blog&sslmode=disable

# ============================================
# SERVER
# ============================================
PORT=8000
BACKEND_PORT=8000

# CORS (comma-separated list of allowed origins)
# For development: http://localhost:3000
# For production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# ============================================
# JWT
# ============================================
JWT_ACCESS_SECRET=nestjsPrismaAccessSecret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============================================
# LOGS
# ============================================
ENABLE_LOGS=false

# Server-only image provider credential. Leave empty to use development mock results.
UNSPLASH_ACCESS_KEY=

# ============================================
# EMAIL
# ============================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev@dash-stack.local
SMTP_PASS=local-dev-only
FRONTEND_URL=http://localhost:3000

# ============================================
# OAUTH
# ============================================
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ============================================
# STORAGE (S3 + CloudFront)
# ============================================

# Provider: 's3' in production; 'local' for development without AWS
STORAGE_PROVIDER=local

# AWS S3 Configuration
AWS_S3_BUCKET=your-public-image-bucket
# Must be a distinct bucket with public access blocked and no public CDN origin.
AWS_PRIVATE_S3_BUCKET=your-private-attachment-bucket
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# CloudFront CDN domain (without https://)
# Note: also configured in frontend/.env.example for Next.js image optimization
AWS_CLOUDFRONT_DOMAIN=your-distribution-id.cloudfront.net

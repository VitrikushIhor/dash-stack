generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  email         String         @unique
  password      String?
  avatar        String?
  emailVerified DateTime?
  firstName     String?
  lastName      String?
  dob           DateTime?
  bio           String?
  urls          String[]       @default([])
  accounts      Account[]
  memberships   Membership[]
  refreshTokens RefreshToken[]
  decks         Deck[]         @relation("UserDecks")
  vocabProgress VocabProgress[] @relation("UserVocabProgress")
  deckLeaderboardEntries DeckLeaderboard[] @relation("UserDeckLeaderboard")
  matchSessions          MatchSession[]
  vocabStudyAttempts     VocabStudyAttempt[]
  vocabImportReceipts    VocabImportReceipt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  type      TokenType
  expires   DateTime
  createdAt DateTime  @default(now())

  @@unique([email, token])
  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Organization {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String?
  logo           String?
  stripeId       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  calendarEvents CalendarEvent[]
  invitations    Invitation[]
  memberships    Membership[]
  projects       Project[]
  tasks          Task[]
  labels         OrganizationLabel[]
}

model Membership {
  id           String        @id @default(cuid())
  userId       String
  orgId        String
  role         OrgRole       @default(MEMBER)
  position     TeamPosition?
  joinedAt     DateTime      @default(now())
  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks        Task[]        @relation("TaskAssignees")

  @@unique([userId, orgId])
  @@index([userId])
  @@index([orgId])
}

model Invitation {
  id           String       @id @default(cuid())
  email        String
  orgId        String
  role         OrgRole      @default(MEMBER)
  token        String       @unique @default(cuid())
  expiresAt    DateTime
  invitedBy    String
  acceptedAt   DateTime?
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([orgId])
  @@index([token])
}

model Project {
  id           String       @id @default(cuid())
  orgId        String
  name         String
  description  String?
  color        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Task {
  id             String          @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus      @default(PLANNED)
  attachments    String[]        @default([])
  organizationId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  completedAt    DateTime?
  dueDate        DateTime?
  startDate      DateTime?
  calendarEvents CalendarEvent[]
  checklists     Checklist[]
  labelId        String?
  label          OrganizationLabel? @relation("TaskLabel", fields: [labelId], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignees      Membership[]    @relation("TaskAssignees")

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@map("tasks")
}

model OrganizationLabel {
  id             String       @id @default(cuid())
  name           String
  color          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          Task[]       @relation("TaskLabel")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("organization_labels")
}

model Checklist {
  id     String          @id @default(cuid())
  name   String
  taskId String
  items  ChecklistItem[]
  task   Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(cuid())
  title       String
  completed   Boolean   @default(false)
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@map("checklist_items")
}

model CalendarEvent {
  id           String       @id @default(cuid())
  orgId        String
  taskId       String?
  title        String
  start        DateTime
  end          DateTime?
  type         EventType    @default(TASK)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id])

  @@index([orgId])
  @@index([start])
}

model Deck {
  id               String            @id @default(cuid())
  ownerUserId      String
  title            String
  slug             String?           @unique
  description      String?
  language         String            @default("en")
  level            CEFRLevel?
  tags             String[]          @default([])
  visibility       DeckVisibility    @default(PRIVATE)
  status           DeckStatus        @default(DRAFT)
  type             DeckType          @default(USER_GENERATED)
  forkedFromDeckId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  owner            User              @relation("UserDecks", fields: [ownerUserId], references: [id], onDelete: Cascade)
  flashcards       Flashcard[]
  vocabProgress    VocabProgress[]
  leaderboard      DeckLeaderboard[]
  matchSessions     MatchSession[]
  studyAttempts    VocabStudyAttempt[]
  importReceipts   VocabImportReceipt[]
  forkedFrom       Deck?             @relation("DeckForks", fields: [forkedFromDeckId], references: [id], onDelete: SetNull)
  forks            Deck[]            @relation("DeckForks")

  @@index([ownerUserId])
  @@index([visibility, status])
  @@map("decks")
}

model Flashcard {
  id          String          @id @default(cuid())
  deckId      String
  term        String
  definition  String
  example     String?
  imageUrl    String?
  position    Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  deck        Deck            @relation(fields: [deckId], references: [id], onDelete: Cascade)
  progress      VocabProgress[]
  matchSessions MatchSessionCard[]
  studyAttempts VocabStudyAttempt[]

  @@index([deckId, position])
  @@map("flashcards")
}

model VocabProgress {
  id             String              @id @default(cuid())
  userId         String
  deckId         String
  flashcardId    String
  status         VocabProgressStatus @default(NEW)
  box            Int                 @default(1)
  isStarred      Boolean             @default(false)
  correctStreak  Int                 @default(0)
  correctCount   Int                 @default(0)
  incorrectCount Int                 @default(0)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user           User                @relation("UserVocabProgress", fields: [userId], references: [id], onDelete: Cascade)
  deck           Deck                @relation(fields: [deckId], references: [id], onDelete: Cascade)
  flashcard      Flashcard           @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, deckId, flashcardId])
  @@index([userId, deckId, nextReviewAt])
  @@index([userId, nextReviewAt])
  @@index([deckId])
  @@map("vocab_progress")
}

model VocabStudyAttempt {
  userId      String
  attemptId   String   @db.VarChar(100)
  deckId      String
  flashcardId String
  isCorrect   Boolean
  processedAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck      Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@id([userId, attemptId])
  @@index([deckId])
  @@index([flashcardId])
  @@map("vocab_study_attempts")
}

model VocabImportReceipt {
  userId      String
  importId    String   @db.VarChar(100)
  deckId      String
  payloadHash String   @db.VarChar(64)
  cardIds     String[]
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([userId, importId])
  @@index([deckId])
  @@map("vocab_import_receipts")
}

model MatchSession {
  id          String    @id @default(cuid())
  deckId      String
  userId      String
  startedAt   DateTime
  expiresAt   DateTime
  completedAt DateTime?

  deck  Deck               @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards MatchSessionCard[]

  @@index([deckId])
  @@index([userId])
  @@index([expiresAt])
  @@map("match_sessions")
}

model MatchSessionCard {
  sessionId   String
  flashcardId String
  position    Int
  matchedAt   DateTime?

  session   MatchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  flashcard Flashcard    @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@id([sessionId, flashcardId])
  @@unique([sessionId, position])
  @@index([flashcardId])
  @@map("match_session_cards")
}

model DeckLeaderboard {
  id         String   @id @default(cuid())
  deckId     String
  userId     String
  durationMs Int
  cardCount  Int
  createdAt  DateTime @default(now())

  deck       Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user       User     @relation("UserDeckLeaderboard", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deckId, userId])
  @@index([userId])
  @@index([deckId, durationMs, createdAt, id])
  @@map("deck_leaderboards")
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum TeamPosition {
  PRODUCT_MANAGER
  LEAD_DEVELOPER
  FRONTEND_DEVELOPER
  BACKEND_DEVELOPER
  UI_UX_DESIGNER
  QA_ENGINEER
  DEVOPS_ENGINEER
}

enum TaskStatus {
  PLANNED
  UPCOMING
  COMPLETED
}

enum EventType {
  TASK
  MEETING
  DEADLINE
  REMINDER
}

enum DeckVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum DeckStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DeckType {
  USER_GENERATED
  SYSTEM
}

enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum VocabProgressStatus {
  NEW
  LEARNING
  KNOWN
  MASTERED
  FORGOTTEN
}

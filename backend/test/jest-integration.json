{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../src",
  "testRegex": ".*\\.integration\\.test\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@auth/(.*)$": "<rootDir>/auth/$1",
    "^@common/(.*)$": "<rootDir>/common/$1",
    "^@email/(.*)$": "<rootDir>/email/$1",
    "^@health/(.*)$": "<rootDir>/health/$1",
    "^@invitation/(.*)$": "<rootDir>/invitation/$1",
    "^@label/(.*)$": "<rootDir>/label/$1",
    "^@organization/(.*)$": "<rootDir>/organization/$1",
    "^@storage/(.*)$": "<rootDir>/storage/$1",
    "^@task/(.*)$": "<rootDir>/task/$1",
    "^@user/(.*)$": "<rootDir>/user/$1",
    "^@vocab/(.*)$": "<rootDir>/vocab/$1"
  },
  "testEnvironment": "node"
}

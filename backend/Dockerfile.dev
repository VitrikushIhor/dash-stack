FROM node:22-alpine

WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# Install dependencies first (cached layer)
COPY package.json ./
COPY prisma ./prisma/

RUN pnpm install

# Copy source code explicitly to avoid leaking sensitive files
COPY src ./src/
COPY tsconfig.json tsconfig.build.json ./
COPY nest-cli.json ./

# Use non-root user
USER node

# Expose port
EXPOSE 8000

# Run in development mode with hot-reload
CMD ["pnpm", "run", "dev"]

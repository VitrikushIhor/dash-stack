  learningTopics                  LearningTopic[]            @relation("LearningTopicOwner")
  learningTests                   LearningTest[]             @relation("LearningTestOwner")
  learningOpenings                LearningOpening[]          @relation("LearningOpeningUser")
  learningAttempts                LearningAttempt[]          @relation("LearningAttemptUser")
  uploadedLearningAssets          LearningAsset[]            @relation("LearningAssetUploader")
  platformRoleAssignment          PlatformRoleAssignment?    @relation("PlatformRoleAssignmentUser")
  assignedPlatformRoles           PlatformRoleAssignment[]   @relation("PlatformRoleAssignmentActor")
  openedLearningModerationCases   LearningModerationCase[]   @relation("LearningModerationCaseActor")
  liftedLearningTestRestrictions  LearningTestRestriction[]  @relation("LearningTestRestrictionActor")
  liftedLearningTopicRestrictions LearningTopicRestriction[] @relation("LearningTopicRestrictionActor")
  platformAuditEvents             PlatformAuditEvent[]       @relation("PlatformAuditEventActor")

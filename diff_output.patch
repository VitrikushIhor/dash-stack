+  })
+  .partial()
+
+export type LabelDto = z.infer<typeof labelSchema>
+export type CreateLabelDto = z.infer<typeof CreateLabelDtoSchema>
+export type UpdateLabelDto = z.infer<typeof UpdateLabelDtoSchema>

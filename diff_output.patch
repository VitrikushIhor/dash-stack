+import { describe, expect, it, vi } from 'vitest'
+import { ROUTES } from '@/shared/config/constants/routes'
+import { render, screen } from '@/shared/lib/test/test-utils'
+import SignInRoute from './page'
+
+vi.mock('@/views/auth', () => ({

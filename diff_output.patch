+    it('should return null when passed null', () => {
+      // Arrange
+      const rawPrismaLabel = null;
+
+      // Act
+      const result = PrismaLabelMapper.toDomain(rawPrismaLabel);
+
+      // Assert
+      expect(result).toBeNull();
+    });

+    const cancelButton = screen.getByRole('button', { name: /cancel/i })
+    const confirmButton = screen.getByRole('button', { name: /deleting/i })
+
+    expect(cancelButton).toBeDisabled()
+    expect(confirmButton).toBeDisabled()
+  })
+})

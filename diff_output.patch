+describe('SignupUseCase', () => {
+  let useCase: SignupUseCase;
+  let userRepoMock: any;
+  let verificationTokenRepoMock: any;
+  let passwordHasherMock: any;
+  let mailerMock: any;
+
+  beforeEach(() => {
+    userRepoMock = {
+      findByEmail: jest.fn(),
+      create: jest.fn(),
+    };
+    verificationTokenRepoMock = {
+      create: jest.fn(),
+    };
+    passwordHasherMock = {
+      hashPassword: jest.fn(),
+    };
